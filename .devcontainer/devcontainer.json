{
  "name": "ses-arama",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements.txt",
  "postAttachCommand": "nohup uvicorn server:app --host 0.0.0.0 --port 8000 > server.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Ses Arama", "onAutoForward": "notify" }
  }
}
